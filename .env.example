# AI Provider Configuration
# By default, this connects to a local server like LM Studio or Ollama

# Base URL for the AI Service (Localhost Example)
VITE_AI_BASE_URL=http://localhost:1234/v1

# Model ID (Check your local provider for the exact string, e.g. "llama-2-7b-chat")
VITE_AI_MODEL=local-model

# API Key (Usually not needed for local, but can be set if using OpenAI/DeepSeek directly)
# VITE_AI_API_KEY=sk-xxxx
